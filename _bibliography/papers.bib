@article{FCAM,
  author={Tang, Shi and Luo, Guiming and Ye, Xinchen and Xia, Zhiyi},
  title={Harnessing the Power of Local Representations for Few-Shot Classification},
  journal= {Pattern Recognition},
  volume = {179},
  pages = {113597},
  year = {2026},
  issn = {0031-3203},
  abstract={Generalization to unseen classes is a central challenge in few-shot classification. While recent metric-based methods leverage local representations to address this, their effectiveness is often limited by two key issues: (i) inadequate supervision during feature extractor pretraining, and (ii) inflexible similarity metrics that struggle with diverse local feature set compositions. In this work, we fully harness the potential of local representations to overcome these limitations. First, we introduce a novel pretraining paradigm for the feature extractor that learns from randomly cropped image patches using soft labels. This approach captures class-level diversity while mitigating semantic misalignment from hard labels. To align network outputs with these soft labels, we propose the UniCon KL-Divergence loss, ensuring balanced contributions from all base classes for “non-base” patches. Second, for the similarity metric, we formulate the matching of local feature sets as an entropy-regularized optimal transport problem, effectively handling homogeneous sets. We further imbue the metric with adaptability through a dedicated Modulation Module. Our method achieves state-of-the-art performance on three widely-used benchmarks, notably surpassing both transductive and cross-modal approaches in fine-grained classification scenarios.},
  doi = {https://doi.org/10.1016/j.patcog.2026.113597},
  html={https://www.sciencedirect.com/science/article/pii/S0031320326005637},
  arxiv={https://arxiv.org/abs/2407.01967},
  preview={FCAM.png},
  selected={true}}

@UNPUBLISHED{UniEM,
  author={Wang, Nan and Xia, Zhiyi and Li, Yiming and Tang, Shi and Fan, Zuxin and Fang, Xi and Tao, Haoyi and Cai, Xiaochen and Ke, Guolin and Zhang, Linfeng and Hong, Yanhui},
  title={UniEM-3M: A Universal Electron Micrograph Dataset for Microstructural Segmentation and Generation},
  year={2025},
  note={Under review at ECCV},
  abstract={Quantitative microstructural characterization is fundamental to materials science, where electron micrograph (EM) provides indispensable high-resolution insights. However, progress in deep learning-based EM characterization has been hampered by the scarcity of large-scale, diverse, and expert-annotated datasets, due to acquisition costs, privacy concerns, and annotation complexity. To address this issue, we introduce UniEM-3M, the first large-scale and multimodal EM dataset for instance-level understanding. It comprises 5,091 high-resolution EMs, about 3 million instance segmentation labels, and image-level attribute-disentangled textual descriptions, a subset of which will be made publicly available. Furthermore, we are also releasing a text-to-image diffusion model trained on the entire collection to serve as both a powerful data augmentation tool and a proxy for the complete data distribution. To establish a rigorous benchmark, we evaluate various representative instance segmentation methods on the complete UniEM-3M and present UniEM-Net as a strong baseline model. Quantitative experiments demonstrate that this flow-based model outperforms other advanced methods on this challenging benchmark. Our multifaceted release of a partial dataset, a generative model, and a comprehensive benchmark -- available at huggingface -- will significantly accelerate progress in automated materials analysis.},
  html={https://arxiv.org/abs/2508.16239},
  preview={UniEM.png},
  selected={true}}

@INPROCEEDINGS{cross_modality,
  author={Tang, Shi and Ye, Xinchen and Xue, Fei and Xu, Rui},
  booktitle={IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)}, 
  title={Cross-Modality Depth Estimation via Unsupervised Stereo RGB-to-Infrared Translation}, 
  year={2023},
  abstract={Existing depth estimation methods infer scene depth only from stereo visible light (RGB) images. Since RGB imaging is sensitive to changes in light, it is difficult to estimate depth information accurately in some degraded visibility conditions. In contrast, infrared (IR) imaging captures thermal radiation and is not affected by brightness changing, providing extra clues for depth estimation. However, most datasets used for training in depth estimation do not have IR images paired with RGB-D data. Therefore, how to obtain the paired IR images and exploit the respective advantages of RGB and IR images to improve the performance of depth estimation, is of vital importance. Our core idea is to first develop an unsupervised RGB-to-IR translation (RIT) network with proposed Fourier domain adaptation and multi-space warping regularization to synthesize stereo IR images from their corresponding stereo RGB images. And then modified depth estimation backbones can be used as the cross-modality depth estimation (CDE) network to infer disparity maps from cross-modal RGB-IR stereo pairs. Assisted by the synthetic stereo IR images, we obtain superior performance just by flexibly deploying our framework to several off-the-shelf depth estimation backbones of single-modality (RGB) based methods.},
  html={https://ieeexplore.ieee.org/abstract/document/10095982},
  pdf={cross_modality.pdf},
  preview={cross_modality.png},
  selected={true}}
